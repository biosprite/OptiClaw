<Window
    x:Class="OptiClaw.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OptiClaw.Core.Models"
    Title="OptiClaw">

    <Grid
        x:Name="RootGrid"
        Loaded="RootGrid_Loaded"
        RequestedTheme="Default"
        Background="{ThemeResource ClawPageBrush}"
        XYFocusKeyboardNavigation="Enabled">
        <Grid.Resources>
            <Storyboard x:Name="StartupRevealStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="StartupOverlay"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.14" />
                <DoubleAnimation
                    Storyboard.TargetName="HeaderPanel"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    BeginTime="0:0:0.03"
                    Duration="0:0:0.18" />
                <DoubleAnimation
                    Storyboard.TargetName="WorkspacePanel"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    BeginTime="0:0:0.06"
                    Duration="0:0:0.22" />
                <DoubleAnimation
                    Storyboard.TargetName="FooterPanel"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    BeginTime="0:0:0.09"
                    Duration="0:0:0.18" />
            </Storyboard>
            <Storyboard x:Name="StartupIndicatorStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="StartupIndicator"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.12" />
            </Storyboard>
            <Storyboard x:Name="GuideRevealStoryboard">
                <DoubleAnimation Storyboard.TargetName="GuidePanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="LibraryRevealStoryboard">
                <DoubleAnimation Storyboard.TargetName="WorkspacePanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleBarDescriptor.Visibility" Value="Collapsed" />
                        <Setter Target="TitleBarText.Margin" Value="16,0,0,0" />
                        <Setter Target="HeaderPanel.Margin" Value="16,2,8,8" />
                        <Setter Target="WorkspacePanel.Margin" Value="16,0,16,12" />
                        <Setter Target="GuidePanel.Margin" Value="16,0,16,12" />
                        <Setter Target="WorkspacePanel.ColumnSpacing" Value="12" />
                        <Setter Target="LibraryColumn.Width" Value="320" />
                        <Setter Target="DetailsPanel.Padding" Value="20" />
                        <Setter Target="SelectedGameNameText.FontSize" Value="26" />
                        <Setter Target="ProxyColumn.Width" Value="180" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RegularLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleBarDescriptor.Visibility" Value="Visible" />
                        <Setter Target="TitleBarText.Margin" Value="24,0,0,0" />
                        <Setter Target="HeaderPanel.Margin" Value="24,2,16,10" />
                        <Setter Target="WorkspacePanel.Margin" Value="24,0,24,18" />
                        <Setter Target="GuidePanel.Margin" Value="24,0,24,18" />
                        <Setter Target="WorkspacePanel.ColumnSpacing" Value="16" />
                        <Setter Target="LibraryColumn.Width" Value="360" />
                        <Setter Target="DetailsPanel.Padding" Value="28" />
                        <Setter Target="SelectedGameNameText.FontSize" Value="30" />
                        <Setter Target="ProxyColumn.Width" Value="220" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <TitleBar.LeftHeader>
                <StackPanel x:Name="TitleBarText" Margin="24,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <TextBlock
                        Text="OptiClaw"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <StackPanel x:Name="TitleBarDescriptor" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="-" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock
                            Text="Lightweight OptiScaler Client for Intel Devices"
                            FontSize="12"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>

        <CommandBar
            x:Name="HeaderPanel"
            Grid.Row="1"
            Margin="24,2,16,10"
            Padding="0"
            HorizontalAlignment="Right"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="False"
            OverflowButtonVisibility="Collapsed"
            Opacity="0">
            <AppBarButton
                Label="Scan libraries"
                Click="ScanLibraries_Click"
                ToolTipService.ToolTip="Scan installed Steam and Xbox libraries"
                AutomationProperties.Name="Scan installed game libraries">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Label="App data"
                Click="AppDataFolder_Click"
                ToolTipService.ToolTip="Open the OptiClaw data folder to manage or delete stored data"
                AutomationProperties.Name="Open the OptiClaw app data folder">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                x:Name="GuideButton"
                Label="Guide"
                Click="Guide_Click"
                ToolTipService.ToolTip="Open the OptiScaler setup guide"
                AutomationProperties.Name="Open the OptiScaler setup guide">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE82D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="UpstreamButton"
                Label="Checking…"
                Click="Upstream_Click"
                ToolTipService.ToolTip="Open the official OptiScaler GitHub repository"
                AutomationProperties.Name="Open the official OptiScaler GitHub repository">
                <AppBarButton.Icon>
                    <PathIcon Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.6-.18-3.28-.8-3.28-3.56 0-.79.28-1.43.74-1.93-.07-.18-.32-.91.07-1.9 0 0 .6-.19 1.97.74A6.865 6.865 0 0 1 8 4.69c.61 0 1.23.08 1.79.23 1.36-.93 1.96-.74 1.96-.74.39.99.14 1.72.07 1.9.46.5.74 1.14.74 1.93 0 2.77-1.69 3.38-3.3 3.56.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarElementContainer>
                <SelectorBar
                    x:Name="ThemeSelector"
                    Padding="0"
                    SelectionChanged="ThemeSelector_SelectionChanged">
                    <SelectorBarItem
                        x:Name="LightThemeItem"
                        Tag="Light"
                        ToolTipService.ToolTip="Light theme"
                        AutomationProperties.Name="Light theme">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="DarkThemeItem"
                        Tag="Dark"
                        ToolTipService.ToolTip="Dark theme"
                        AutomationProperties.Name="Dark theme">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE708;" FontSize="16" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="SystemThemeItem"
                        Tag="Default"
                        ToolTipService.ToolTip="Use system settings"
                        AutomationProperties.Name="System Theme">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </AppBarElementContainer>
        </CommandBar>

        <Grid x:Name="WorkspacePanel" Grid.Row="2" Margin="24,0,24,18" ColumnSpacing="16" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource ClawCardBrush}" BorderBrush="{ThemeResource ClawCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="GameCountText" Text="GAME LIBRARY - 0 GAMES" FontSize="11" CharacterSpacing="110" Foreground="{ThemeResource ClawMutedBrush}" />

                    <AutoSuggestBox
                        x:Name="GameSearchBox"
                        Grid.Row="1"
                        Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        QueryIcon="Find"
                        PlaceholderText="Search added games"
                        TextChanged="GameSearchBox_TextChanged"
                        KeyDown="GameSearchBox_KeyDown"
                        AutomationProperties.Name="Search added games" />

                    <Grid Grid.Row="2" Margin="0,8,0,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="AddGame_Click" Style="{StaticResource HandheldButtonStyle}" Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add game" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="ScanFolder_Click" Style="{StaticResource HandheldButtonStyle}" Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                                <TextBlock Text="Scan folder" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SortGamesButton"
                            Grid.Column="2"
                            Style="{StaticResource HandheldButtonStyle}"
                            Width="44"
                            Padding="0"
                            Click="SortGames_Click"
                            ToolTipService.ToolTip="Sort games Z to A"
                            AutomationProperties.Name="Sort games Z to A">
                            <SymbolIcon Symbol="Sort" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3">
                        <ListView
                            x:Name="GamesList"
                            ItemsSource="{x:Bind VisibleGames}"
                            SelectionChanged="GamesList_SelectionChanged"
                            IsItemClickEnabled="False"
                            SelectionMode="Single"
                            HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="MinHeight" Value="64" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:GameProfile">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding StatusKind, Mode=OneWay, Converter={StaticResource GameStatusBrushConverter}}" CornerRadius="4" Margin="0,2" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StatusSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ClawMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="EmptyLibraryPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource ClawMutedBrush}" />
                            <TextBlock x:Name="EmptyLibraryTitle" Text="No compatible games yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyLibraryHelpText" Text="Add an EXE or scan a folder." FontSize="12" Foreground="{ThemeResource ClawMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource ClawCardBrush}" BorderBrush="{ThemeResource ClawCardBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <StackPanel x:Name="EmptyDetailsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource ClawInsetBrush}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="28" Foreground="{ThemeResource ClawMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Choose a game" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Its detected upscalers and install controls will appear here." MaxWidth="380" Foreground="{ThemeResource ClawMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer x:Name="DetailsPanel" Visibility="Collapsed" Padding="28" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SelectedGameNameText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedGameSourceText" Margin="0,5,0,0" Foreground="{ThemeResource ClawMutedBrush}" />
                                    <Border Margin="0,12,0,0" Background="#4A3815" CornerRadius="4" Padding="14,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FFD800" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Single-player only" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="DLL injection may trigger anti-cheat systems and result in bans from online services." FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Border Margin="0,8,0,0" Background="{StaticResource ClawXeSSBlueBadgeBrush}" CornerRadius="4" Padding="14,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{StaticResource ClawXeSSBlueBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Detected" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="DetectedInputsText" Grid.Column="1" Text="None found" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="Detected files may not be enabled in-game." FontSize="11" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="InstallStateBadge" Background="{StaticResource ClawReadyBadgeBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Top">
                                    <TextBlock x:Name="InstallStateText" Text="READY" FontSize="11" CharacterSpacing="100" Foreground="{StaticResource ClawGreenBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <StackPanel Spacing="7">
                                <TextBlock Text="GAME EXECUTABLE" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource ClawMutedBrush}" />
                                <TextBlock x:Name="ExecutablePathText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Text="INSTALL BESIDE" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource ClawMutedBrush}" />
                                <TextBlock x:Name="DeploymentPathText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ProxyColumn" Width="220" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="PROXY DLL" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource ClawMutedBrush}" />
                                    <ComboBox x:Name="ProxyDllCombo" ItemsSource="{x:Bind ProxyDllNames}" SelectedIndex="0" MinHeight="44" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <Button x:Name="InstallButton" Grid.Column="1" Click="Install_Click" Style="{StaticResource AccentButtonStyle}" MinHeight="44" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <FontIcon Glyph="&#xE896;" FontSize="15" />
                                        <TextBlock Text="Install XeSS" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestoreButton" Grid.Column="2" Click="Restore_Click" MinHeight="44" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE777;" FontSize="15" />
                                        <TextBlock Text="Restore" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="RescanGame_Click" Style="{StaticResource HandheldButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="Scan again" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Click="OpenFolder_Click" Style="{StaticResource HandheldButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock Text="Open folder" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="RemoveGame_Click" Style="{StaticResource HandheldButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="Remove" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ContentControl
                                x:Name="FrameGenerationPanel"
                                IsEnabled="False"
                                HorizontalContentAlignment="Stretch">
                                <Border Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                                    <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="FRAME GENERATION" FontSize="10" CharacterSpacing="120" Foreground="{ThemeResource ClawMutedBrush}" />
                                            <TextBlock Text="Configure OptiScaler FG without opening its in-game overlay." FontSize="12" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="FrameGenerationEnabledToggle"
                                            Grid.Column="1"
                                            OffContent="Off"
                                            OnContent="On"
                                            HorizontalAlignment="Right"
                                            Margin="24,0,0,0"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="FG INPUT" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource ClawMutedBrush}" />
                                            <ComboBox
                                                x:Name="FrameGenerationInputCombo"
                                                ItemsSource="{x:Bind FrameGenerationInputOptions}"
                                                DisplayMemberPath="Label"
                                                SelectedIndex="0"
                                                HorizontalAlignment="Stretch" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="FG OUTPUT" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource ClawMutedBrush}" />
                                            <ComboBox
                                                x:Name="FrameGenerationOutputCombo"
                                                ItemsSource="{x:Bind FrameGenerationOutputOptions}"
                                                DisplayMemberPath="Label"
                                                SelectedIndex="0"
                                                HorizontalAlignment="Stretch" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="MULTIPLIER" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource ClawMutedBrush}" />
                                            <ComboBox
                                                x:Name="FrameGenerationMultiplierCombo"
                                                ItemsSource="{x:Bind FrameGenerationMultiplierOptions}"
                                                DisplayMemberPath="Label"
                                                SelectedIndex="0"
                                                HorizontalAlignment="Stretch" />
                                        </StackPanel>

                                        <Button
                                            Grid.Column="3"
                                            Click="ApplyFrameGeneration_Click"
                                            Content="Apply"
                                            MinHeight="42"
                                            Padding="18,8"
                                            VerticalAlignment="Bottom" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="FrameGenerationHelpText"
                                        Text="Install XeSS to configure frame generation."
                                        FontSize="11"
                                        Foreground="{ThemeResource ClawMutedBrush}"
                                        TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="GuidePanel"
            Grid.Row="2"
            Margin="24,0,24,18"
            Background="{ThemeResource ClawCardBrush}"
            BorderBrush="{ThemeResource ClawCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <ScrollViewer Padding="28" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Center" Spacing="18">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#4A3815" CornerRadius="4" Padding="14,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FFD800" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Single-player only" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Test offline without anti-cheat. Change one setting at a time and restart after FG changes." FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Click="GuideDocs_Click" MinHeight="36" Padding="12,7" CornerRadius="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock Text="Official wiki" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="{StaticResource ClawXeSSBlueBadgeBrush}" CornerRadius="4" Padding="14,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="{StaticResource ClawXeSSBlueBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Default keys" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Insert" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="opens the menu" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="End" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="toggles FG" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="On a handheld, map them to spare rear or back buttons." FontSize="12" Foreground="{ThemeResource ClawMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="12">
                        <TextBlock Text="SETUP BASICS" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource ClawMutedBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource ClawXeSSBlueBadgeBrush}">
                                            <TextBlock Text="1" Foreground="{StaticResource ClawXeSSBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Pick the input" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Use the highest-ranked compatible input below. Confirm the upscaler works before changing anything else." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource ClawXeSSBlueBadgeBrush}">
                                            <TextBlock Text="2" Foreground="{StaticResource ClawXeSSBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Stabilize real FPS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Tune graphics before enabling FG. Aim for a steady 45–60 real FPS. Below 40, lower demanding settings first." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource ClawXeSSBlueBadgeBrush}">
                                            <TextBlock Text="3" Foreground="{StaticResource ClawXeSSBlueBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Add FG last" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Use native FG when available. Select an FG Input and Output, save, restart, then check smoothness, controls and the HUD." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="UPSCALER INPUT PRIORITY" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource ClawMutedBrush}" />
                        <Border Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="16">
                            <Grid RowSpacing="12" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RANK / INPUT" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource ClawMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="BEST USE CASE" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource ClawMutedBrush}" />
                                <TextBlock Grid.Column="2" Text="WATCH FOR" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource ClawMutedBrush}" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ClawXeSSBlueBadgeBrush}">
                                        <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ClawXeSSBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="DLSS input" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="First choice for most swaps. It usually supplies the motion, depth and exposure data OptiScaler needs." FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Some games hide DLSS on non-NVIDIA GPUs. Check the compatibility list for workarounds." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ClawXeSSBlueBadgeBrush}">
                                        <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ClawXeSSBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="FSR input" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Second choice. Prefer FSR 3.1 because it uses a standardized API." FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="FSR 2 and FSR 3 implementations vary by game." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                    <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource ClawXeSSBlueBadgeBrush}">
                                        <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ClawXeSSBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="XeSS input" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Use when XeSS is the only input, or swap the game's XeSS path to OptiScaler XeSS for potentially better image quality." FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Compare image quality per game. In Unreal Engine, use XeSS or FSR4 output because the XeSS plugin does not supply depth." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource ClawCardBorderBrush}" />
                            <TextBlock Text="FRAME GENERATION INPUT PRIORITY" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource ClawMutedBrush}" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="1  DLSSG via Streamline" FontWeight="SemiBold" />
                                    <TextBlock Text="Best for DX12 Streamline 2+ games with native DLSS FG. Enable FG in-game and in OptiScaler, then save and restart." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="2  Native FSR 3.1 / 3.0 FG" FontWeight="SemiBold" />
                                    <TextBlock Text="Use the game's native FSR FG input. Enable FG in-game and in OptiScaler, then save and restart." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="3  OptiFG / Upscaler" FontWeight="SemiBold" />
                                    <TextBlock Text="Experimental fallback for DX12 games without working native FG. Check the HUD for ghosting or duplicated frames." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="XEFG CHECKLIST" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource ClawMutedBrush}" />
                        <Border Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                            <Grid ColumnSpacing="18" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="✓  Use DX12 and Borderless Fullscreen" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="✓  Use HDR10. XeFG does not support scRGB or FP16 HDR" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="✓  Restart when the overlay tells you to" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="✓  Confirm FPS rises and frame pacing stays flat" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="×  No Vulkan or Exclusive Fullscreen" Foreground="{StaticResource ClawOrangeBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="×  No RTSS Reflex injection, Anti-Lag 1 or Enhanced Sync" Foreground="{StaticResource ClawOrangeBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="BASE FPS &amp; MULTIPLIER TIPS" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource ClawMutedBrush}" />
                        <Border Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="45–60" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ClawGreenBrush}" />
                                    <TextBlock Text="real FPS target" FontSize="13" Foreground="{ThemeResource ClawMutedBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Start at 2× for the fewest artifacts. Try 3× only with stable base FPS and a high-refresh display. Use 4× cautiously." FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="FG smooths motion but does not improve input response. Below 40 real FPS, lower graphics settings or leave FG off." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="VERIFY BEFORE YOU KEEP IT" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource ClawMutedBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                                <TextBlock Text="Pan the camera and inspect character edges, foliage and transparent effects. Watch the HUD for ghosting or duplication." FontSize="14" TextWrapping="Wrap" />
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource ClawInsetBrush}" CornerRadius="10" Padding="18">
                                <TextBlock Text="Compare the same scene with FG off and on. Keep FG only if motion is smoother and controls still feel responsive." FontSize="14" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Border Background="{StaticResource ClawXeSSBlueBadgeBrush}" CornerRadius="10" Padding="18">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Need a game-specific answer?" FontWeight="SemiBold" />
                                <TextBlock Text="Check the official compatibility list for game-specific fixes." FontSize="14" Foreground="{ThemeResource ClawMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="GuideCompatibility_Click" Content="Compatibility list" />
                            <Button Grid.Column="2" Click="GuideFrameGeneration_Click" Content="FG documentation" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="FooterPanel" Grid.Row="3" Background="{ThemeResource ClawFooterBrush}" Padding="24,10" Opacity="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="9">
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" />
            </StackPanel>
            <ProgressBar x:Name="WorkProgress" Grid.Column="1" Visibility="Collapsed" Minimum="0" Maximum="1" Foreground="{StaticResource ClawXeSSBlueBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid
            x:Name="StartupOverlay"
            Grid.Row="1"
            Grid.RowSpan="3"
            Background="{ThemeResource ClawPageBrush}">
            <StackPanel
                x:Name="StartupIndicator"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Opacity="0">
                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="True"
                    Foreground="{StaticResource ClawRedBrush}" />
                <TextBlock
                    Text="Loading your library"
                    FontSize="12"
                    Foreground="{ThemeResource ClawMutedBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
